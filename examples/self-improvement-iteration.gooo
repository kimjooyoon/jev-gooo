module self_improvement_iteration\n\ninput observation_receipt\ninput candidate_change\ninput verification_evidence\ninput rollback_condition\n\nstatus PROPOSED\nstatus ACCEPTED\nstatus REJECTED\nstatus UNKNOWN\n\nfield observation_receipt\nfield candidate_change\nfield verification_evidence\nfield rollback_condition\nfield first_missing_stage\nfield next_operation\n\nconstraint observation_only\nconstraint no_execution\nconstraint no_authorization\nconstraint provenance_continuity\nconstraint metric_not_truth\nconstraint unknown_preserves_first_missing_stage\nconstraint rollback_must_be_explicit\n